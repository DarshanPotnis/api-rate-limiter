# Copy to .env and adjust. Real environment variables take precedence over .env.

# Host port `docker compose` publishes Redis on (read by Compose, not the app).
REDIS_PORT=6379

# Level for the app's own logs, such as the Ollama token-drift line (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Redis used by the app. Matches `docker compose up -d` with the default port.
REDIS_URL=redis://localhost:6379/0

# Gateway: max_tokens reserved when a request sends neither max_tokens nor
# max_completion_tokens, and the mock provider's simulated response time.
DEFAULT_MAX_TOKENS=256
MOCK_LATENCY_SECONDS=0

# Ollama runs natively on macOS (not in Docker) so it can use the GPU. Connecting should
# be instant; the read timeout covers a cold model load plus the whole generation.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_CONNECT_TIMEOUT_SECONDS=2
OLLAMA_READ_TIMEOUT_SECONDS=120

# Models the "auto" alias tries in order. Defaults to OLLAMA_MODEL, then mock.
# AUTO_FALLBACK=llama3.2:3b,mock

# The test suite does not read this file. It uses TEST_REDIS_URL from the shell,
# defaulting to a separate database on the same Redis:
#   TEST_REDIS_URL=redis://localhost:6379/15 pytest
